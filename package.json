{
  "name": "ui-watchtower",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "build": "ng build --configuration=production --project=ngx-ui-watchtower",
    "watch": "ng build ngx-ui-watchtower --watch --configuration development",
    "lab": "node projects/watchtower-lab/server/dev.mjs",
    "lab:build": "ng build watchtower-lab-fragment && ng build watchtower-lab",
    "e2e": "npm run lab:build && playwright test",
    "e2e:ui": "npm run lab:build && playwright test --ui",
    "smoke": "node projects/watchtower-consumer-smoke/smoke.mjs",
    "test": "ng test --project=ngx-ui-watchtower",
    "test:coverage": "ng test --project=ngx-ui-watchtower --coverage --coverage-reporters text-summary --coverage-reporters lcov --json --output-file=./coverage/report.json",
    "lint": "eslint \"**/*.ts\" --max-warnings=0",
    "format": "prettier --write \"**/*.{ts,html}\"",
    "format:check": "prettier --check \"**/*.{ts,html}\"",
    "typecheck": "tsc -p projects/ngx-ui-watchtower/tsconfig.lib.json --noEmit && tsc -p projects/ngx-ui-watchtower/tsconfig.spec.json --noEmit && tsc -p projects/ngx-ui-watchtower/rum/tsconfig.lib.json --noEmit && tsc -p projects/ngx-ui-watchtower/rum/tsconfig.spec.json --noEmit && tsc -p projects/ngx-ui-watchtower/event-inspector/tsconfig.lib.json --noEmit && tsc -p projects/ngx-ui-watchtower/event-inspector/tsconfig.spec.json --noEmit && tsc -p playwright/tsconfig.json"
  },
  "private": true,
  "dependencies": {
    "@angular/common": "~21.2.26",
    "@angular/compiler": "~21.2.26",
    "@angular/core": "~21.2.26",
    "@angular/platform-browser": "~21.2.26",
    "@angular/platform-browser-dynamic": "~21.2.26",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.1"
  },
  "devDependencies": {
    "@angular-builders/jest": "^21.0.4",
    "@angular/animations": "~21.2.26",
    "@angular/build": "~21.2.29",
    "@angular/cli": "~21.2.29",
    "@angular/compiler-cli": "~21.2.26",
    "@angular/forms": "~21.2.26",
    "@angular/platform-server": "~21.2.26",
    "@angular/router": "~21.2.26",
    "@angular/ssr": "~21.2.29",
    "@axe-core/playwright": "4.14.0",
    "@e965/xlsx": "^0.20.3",
    "@playwright/test": "^1.64.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.10.10",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "aws-rum-web": "^3.2.1",
    "cps-ui-kit": "^21.32.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-standard": "^5.0.0",
    "express": "^5.3.0",
    "jest": "^30.3.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-preset-angular": "^17.0.0",
    "lodash": "^4.17.21",
    "lodash-es": "^4.17.21",
    "ng-packagr": "~21.0.1",
    "prettier": "^3.4.2",
    "typescript": "~5.9.3",
    "web-fragments": "^0.8.2"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
