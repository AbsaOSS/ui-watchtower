{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": false,
    "types": [],
    "noImplicitOverride": true,
    "noImplicitReturns": true,
    "moduleResolution": "bundler",
    "importHelpers": true,
    "target": "ES2022",
    "module": "ES2022",
    "lib": ["ES2022", "dom"],
    "useDefineForClassFields": false
  },
  "angularCompilerOptions": {
    "strictInjectionParameters": true,
    "strictTemplates": true
  },
  "files": ["src/main.ts"]
}
