{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "schematicCollections": ["@schematics/angular"],
    "analytics": false
  },
  "projects": {
    "ui-watchtower": {
      "projectType": "library",
      "root": "projects/ui-watchtower",
      "sourceRoot": "projects/ui-watchtower/src",
      "prefix": "uwt",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ui-watchtower/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ui-watchtower/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ui-watchtower/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        }
      }
    },
    "ngx-ui-watchtower": {
      "projectType": "library",
      "root": "projects/ngx-ui-watchtower",
      "sourceRoot": "projects/ngx-ui-watchtower/src",
      "prefix": "uwt",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ngx-ui-watchtower/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-ui-watchtower/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-ui-watchtower/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-builders/jest:run",
          "options": {
            "zoneless": false
          }
        }
      }
    }
  }
}
