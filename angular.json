{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "cli": {
    "schematicCollections": ["@schematics/angular"],
    "analytics": false
  },
  "projects": {
    "ngx-ui-watchtower": {
      "projectType": "library",
      "root": "projects/ngx-ui-watchtower",
      "sourceRoot": "projects/ngx-ui-watchtower/src",
      "prefix": "uwt",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "projects/ngx-ui-watchtower/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "projects/ngx-ui-watchtower/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "projects/ngx-ui-watchtower/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular-builders/jest:run",
          "options": {
            "zoneless": false
          }
        }
      }
    },
    "watchtower-lab": {
      "projectType": "application",
      "root": "projects/watchtower-lab",
      "sourceRoot": "projects/watchtower-lab/src",
      "prefix": "lab",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/watchtower-lab",
            "index": "projects/watchtower-lab/src/index.html",
            "browser": "projects/watchtower-lab/src/main.ts",
            "server": "projects/watchtower-lab/src/main.server.ts",
            "polyfills": ["zone.js"],
            "tsConfig": "projects/watchtower-lab/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "styles": ["projects/watchtower-lab/src/styles.scss"],
            "assets": [
              {
                "glob": "icons.svg",
                "input": "node_modules/cps-ui-kit/assets",
                "output": "assets"
              },
              {
                "glob": "logo-mark.svg",
                "input": "assets/logo",
                "output": "assets/logo"
              }
            ],
            "optimization": false,
            "sourceMap": true,
            "extractLicenses": false,
            "outputMode": "server",
            "ssr": {
              "entry": "projects/watchtower-lab/server/server.ts"
            },
            "externalDependencies": ["htmlrewriter"],
            "security": {
              "allowedHosts": ["localhost"]
            }
          }
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "buildTarget": "watchtower-lab:build",
            "port": 4280
          }
        }
      }
    },
    "watchtower-lab-fragment": {
      "projectType": "application",
      "root": "projects/watchtower-lab-fragment",
      "sourceRoot": "projects/watchtower-lab-fragment/src",
      "prefix": "lab",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/watchtower-lab-fragment",
            "index": "projects/watchtower-lab-fragment/src/index.html",
            "browser": "projects/watchtower-lab-fragment/src/main.ts",
            "tsConfig": "projects/watchtower-lab-fragment/tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "styles": ["projects/watchtower-lab-fragment/src/styles.scss"],
            "baseHref": "/_fragment/lab-fragment/",
            "deployUrl": "/_fragment/lab-fragment/",
            "optimization": false,
            "sourceMap": true,
            "extractLicenses": false
          }
        }
      }
    }
  }
}
